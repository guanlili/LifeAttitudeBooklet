# ================= 人生 Attitude 册子 环境配置 =================
# 复制本文件为 .env（放在仓库根目录），按需填写。
# 不配置 AI_BASE_URL / AI_API_KEY 时，后端自动进入 mock 模式（确定性离线 AI），
# 全部功能可用，适合本地开发与演示。

# OpenAI 兼容接口的 Base URL（不含 /chat/completions 后缀）
# 例：https://api.openai.com/v1 或 https://ark.cn-beijing.volces.com/api/v3
AI_BASE_URL=

# API Key（与 AI_BASE_URL 同时配置才会启用真实 AI；解析失败自动回落 mock）
AI_API_KEY=

# 模型名，例：gpt-4o-mini / doubao-1-5-pro-32k-250115
AI_MODEL=gpt-4o-mini

# 后端端口（前端 Vite proxy 指向该端口）
PORT=3000

# 长联触达：对话沉默超过 N 分钟即生成"重新联系"建议（默认 1，演示友好；生产建议 4320=3天）
RECONNECT_SILENT_MINUTES=1
